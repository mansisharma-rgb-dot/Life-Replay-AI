# ==============================================================================
# Life Replay AI - Backend Environment Template
# ==============================================================================
# IMPORTANT: DO NOT commit your actual .env file to version control.
# Copy this file to '.env' and replace the placeholder values.

# ─── APPLICATION SETTINGS ─────────────────────────────────────────────────────
# Options: development, testing, production
FLASK_ENV=production

# ─── SECURITY SECRETS ─────────────────────────────────────────────────────────
# Must be strong, unpredictable strings (e.g., generated via `openssl rand -hex 32`)
SECRET_KEY=replace_with_a_strong_secret_key
JWT_SECRET_KEY=replace_with_a_strong_jwt_secret

# ─── DATABASE SETTINGS ────────────────────────────────────────────────────────
# In development, you can use SQLite.
# In production, use PostgreSQL or a managed relational database.
DATABASE_URL=postgresql://user:password@localhost:5432/lifereplaydb
# DATABASE_URL=sqlite:///app.db  # Example for development fallback

# ─── AI INTEGRATION ───────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── CORS CONFIGURATION ───────────────────────────────────────────────────────
# Explicitly list allowed frontend origins separated by commas (no wildcards with credentials).
CORS_ORIGINS=http://localhost:5173
CORS_SUPPORTS_CREDENTIALS=True

# ─── FRONTEND & EMAIL CONFIGURATION ───────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com
