# IMPORTANT: DO NOT commit your actual .env file to version control.
# Copy this file to '.env' and replace the placeholder values.

# The base URL for the backend API.
# In development with Vite proxy, this can be empty or relative like '/api'
# In production, this must point to the absolute URL of the deployed backend.
VITE_API_URL=https://api.your-backend-domain.com/api
